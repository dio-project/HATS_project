{
  "name": "HATS Development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/rust:1": { "version": "stable" }
  },
  "forwardPorts": [8000, 5173, 5432],
  "postCreateCommand": "python -m pip install -e '.[dev]' && cd apps/web && npm install",
  "customizations": { "vscode": { "extensions": ["ms-python.python", "ms-python.vscode-pylance", "dbaeumer.vscode-eslint", "rust-lang.rust-analyzer"] } }
}
